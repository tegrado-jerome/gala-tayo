{
  "routes": [
    {
      "route": "/home",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/sitemap.xml",
      "rewrite": "/api/seo/sitemap.xml"
    },
    {
      "route": "/robots.txt",
      "rewrite": "/api/seo/robots.txt"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/images/*",
      "/sitemap.xml",
      "/robots.txt"
    ]
  }
}

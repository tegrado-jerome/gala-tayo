{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "seed:curated-places": "node scripts/seedCuratedPlaces.cjs",
    "seed:metro-manila-places": "node scripts/seedMetroManilaPlaces.cjs",
    "normalize:place-seeds": "node scripts/normalizePlaceSeedData.cjs",
    "validate:place-seeds": "node scripts/validatePlaceSeedData.cjs",
    "seed:validate": "tsx scripts/validateCitySeeds.ts",
    "seed:places": "tsx scripts/seedPlaces.ts",
    "seed:places:write": "tsx scripts/seedPlaces.ts --write",
    "r2:images:dry": "node scripts/uploadR2PlaceImages.cjs",
    "r2:images:upload": "node scripts/uploadR2PlaceImages.cjs --upload",
    "r2:images:report": "node scripts/uploadR2PlaceImages.cjs --report",
    "backfill:image-urls": "tsx scripts/backfillPlaceImageUrls.ts",
    "backfill:image-urls:write": "tsx scripts/backfillPlaceImageUrls.ts --write",
    "test": "echo \"No tests yet...\""
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@google/genai": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.106.1",
    "@upstash/redis": "^1.38.0",
    "sharp": "^0.34.5",
    "@aws-sdk/client-s3": "^3.700.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "azure-functions-core-tools": "^4.x",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }

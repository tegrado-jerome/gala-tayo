{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/functions/**/*.js",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "preseed:places": "npm run build --silent",
    "seed:places": "node dist/scripts/seedGalatayoPlaces.js",
    "seed:researched-content": "npx tsx src/seed/updateResearchedPlaceContent.ts",
    "generate:static-listings": "npx tsx scripts/generateStaticPlaceListings.ts",
    "db:normalize-cities": "npx tsx scripts/normalizeCityNames.ts",
    "seed:place-feedback": "npx tsx seed/seed-place-feedback.ts",
    "deploy": "npm run build && npm prune --production && func azure functionapp publish galatayo-api && npm install",
    "test": "npm run build --silent",
    "test:unit": "npx tsx --test src/services/*.test.ts src/functions/*.test.ts src/utils/*.test.ts src/domain/*.test.ts src/services/assistant/*.test.ts",
    "validate": "npm run build --silent"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@google/genai": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.106.1",
    "@upstash/redis": "^1.38.0",
    "dotenv": "^16.4.5",
    "sharp": "^0.34.5",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "azure-functions-core-tools": "^4.x",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}

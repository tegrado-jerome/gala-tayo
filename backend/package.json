{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/functions/**/*.js",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "backfill:image-urls": "tsx scripts/backfillPlaceImageUrls.ts",
    "backfill:image-urls:write": "tsx scripts/backfillPlaceImageUrls.ts --write",
    "coords:fix": "tsx scripts/fixPlaceCoordinates.cjs",
    "scan:broken-place-images": "tsx scripts/scanBrokenPlaceImages.ts",
    "scan:broken-place-images:write": "tsx scripts/scanBrokenPlaceImages.ts --write",
    "validate": "npm test",
    "test": "npm run build --silent && node scripts/testSearchQueryValidation.cjs"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@google/genai": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.106.1",
    "@upstash/redis": "^1.38.0",
    "sharp": "^0.34.5",
    "@aws-sdk/client-s3": "^3.700.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "azure-functions-core-tools": "^4.x",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}

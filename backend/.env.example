# Local Azure Functions settings and supported development fallbacks only.
# Production secrets belong in Azure Key Vault.

FUNCTIONS_WORKER_RUNTIME=node
AzureWebJobsStorage=
KEY_VAULT_URL=

# Optional public site URL overrides used by the SEO endpoints.
SITE_URL=
PUBLIC_SITE_URL=

# Optional local-development fallbacks read by the current code.
GEMINI_API_KEY=
GROQ_API_KEY=
GEOAPIFY_API_KEY=
ASK_AI_MAP_NORMALIZER_TIMEOUT_MS=
ASK_AI_MAP_NORMALIZER_MAX_TOKENS=
REDIS_REST_URL=
REDIS_REST_TOKEN=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

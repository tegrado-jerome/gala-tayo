{
  "trailingSlash": "never",
  "routes": [
    {
      "route": "/images/*",
      "cacheControl": "public, max-age=31536000, immutable"
    },
    {
      "route": "/assets/*",
      "cacheControl": "public, max-age=31536000, immutable"
    },
    {
      "route": "/fonts/*",
      "cacheControl": "public, max-age=31536000, immutable"
    },
    {
      "route": "/data/place-listings/*",
      "cacheControl": "public, max-age=86400, stale-while-revalidate=604800"
    },
    {
      "route": "/index.html",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "route": "/sw.js",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "route": "/",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "route": "/home",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/search",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/ask-ai",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/ask-ai/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/passport",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/plan-with-ai",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/prompt-builder",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/login",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/signup",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/auth/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/reset-password",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/forgot-password",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/onboarding",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/mfa/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/find-friends",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/profiles/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/profile",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/profile/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/me",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/u/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/account",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/account-settings",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/account-settings/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/settings",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/settings/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/privacy-center",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/favorites",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/lists/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/history",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/feedback",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/reports",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/comment-notices",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/submissions",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/my-submissions",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/gala-plan",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/gala-plan/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/gala-plans",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/gala-plans/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/submit-place",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/places/new",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/places/submit",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/place/*",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/photos/upload",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/admin",
      "rewrite": "/app-shell.html"
    },
    {
      "route": "/admin/*",
      "rewrite": "/app-shell.html"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/app-shell.html"
    }
  },
  "responseHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-site",
    "X-Permitted-Cross-Domain-Policies": "none",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(self)",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://api.open-meteo.com https://*.supabase.co wss://*.supabase.co https://media.galatayo.app https://*.cloudfunctions.net https://*.azurewebsites.net https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://*.supabase.co; media-src 'self' https://media.galatayo.app; object-src 'none'; base-uri 'self'; form-action 'self'"
  }
}
